t;;&#x000A;};&#x000A;&#x000A;/* -------- USB PHYs -------- */&#x000A;&#x000A;&amp;u2phy0 {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;u2phy0_otg {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;u2phy1 {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;u2phy1_otg {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;u2phy2 {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;u2phy2_host {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;u2phy3 {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;u2phy3_host {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;/* -------- Type-C0: 全功能口 (DRD, 支持 DP, SBU, Orientation) -------- */&#x000A;&#x000A;&amp;usbdp_phy0 {&#x000A;	mode-switch;&#x000A;	orientation-switch;&#x000A;	sbu1-dc-gpios = &lt;&amp;gpio4 RK_PA6 GPIO_ACTIVE_HIGH&gt;;&#x000A;	sbu2-dc-gpios = &lt;&amp;gpio4 RK_PA7 GPIO_ACTIVE_HIGH&gt;;&#x000A;	status = &quot;okay&quot;;&#x000A;&#x000A;	port {&#x000A;		#address-cells = &lt;1&gt;;&#x000A;		#size-cells = &lt;0&gt;;&#x000A;&#x000A;		usbdp_phy0_typec_ss: endpoint@0 {&#x000A;			reg = &lt;0&gt;;&#x000A;			remote-endpoint = &lt;&amp;usbc0_ss&gt;;&#x000A;		};&#x000A;&#x000A;		usbdp_phy0_typec_sbu: endpoint@1 {&#x000A;			reg = &lt;1&gt;;&#x000A;			remote-endpoint = &lt;&amp;usbc0_sbu&gt;;&#x000A;		};&#x000A;	};&#x000A;};&#x000A;&#x000A;/* -------- Type-C1: 强制 Host 模式 -------- */&#x000A;&#x000A;&amp;usbdp_phy1 {&#x000A;	phy-supply = &lt;&amp;vbus5v0_usb&gt;;&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;/* -------- USB Host0 (对应 USB20_HOST0 + TypeC0 HS 通道) -------- */&#x000A;&#x000A;&amp;usb_host0_xhci {&#x000A;	dr_mode = &quot;otg&quot;; /* 支持 DRD */&#x000A;	usb-role-switch;&#x000A;	status = &quot;okay&quot;;&#x000A;&#x000A;	port {&#x000A;		usb_host0_xhci_drd_sw: endpoint {&#x000A;			remote-endpoint = &lt;&amp;usbc0_hs&gt;;&#x000A;		};&#x000A;	};&#x000A;};&#x000A;&#x000A;&amp;usb_host0_ehci {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;usb_host0_ohci {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;/* -------- USB Host1 (对应 USB30_2 / USB20_HOST1, 固定 Host 模式) -------- */&#x000A;&#x000A;&amp;usb_host1_xhci {&#x000A;	dr_mode = &quot;host&quot;;&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;usb_host1_ehci {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;&amp;usb_host1_ohci {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;&#x000A;/* USB3.0 Host (combphy2) - usbhost3_0@fcd00000&#x000A;&#x000A;&amp;usb_host2_xhci {&#x000A;	status = &quot;okay&quot;;&#x000A;};&#x000A;*/&#x000A;</textarea>
